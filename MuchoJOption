import javax.swing.JOptionPane;
public class MuchoJOption {
    public static void main(String[]args){

        double balance = 20000;
        double amount;

        while( true ) {

            amount = Double.parseDouble(JOptionPane.showInputDialog( "Enter amount (0 to stop):"));

            if( amount == 0){
                break;
            }
            if( amount > 0){
                balance = balance + amount;

                JOptionPane.showMessageDialog(null," Deposit successful");
            }
            else{
                double withdrawal = - amount;

                if ( withdrawal <= balance){
                    balance = balance - withdrawal;
                    JOptionPane.showMessageDialog(null," Withdrawal successful");

                }else{
                    JOptionPane.showMessageDialog(null," INSUFFICIENT FUNDS!");
                }
            }
            JOptionPane.showMessageDialog(null,"Outstanding Balance: P" + balance);
        }
        JOptionPane.showMessageDialog(null," Program ended. \nFinal Balance: P" + balance);
    }
}
